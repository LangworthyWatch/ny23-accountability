# Cloudflare Pages headers. The CSP's inline-script hashes are filled at build time by
# scripts/csp_headers.py (run after hugo + pagefind, before wrangler pages deploy); the two
# hashes written out literally are the site-wide gtag init and nav-toggle scripts, kept as a
# fallback so the site still works if the script is skipped. Do not hand-edit the token.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://www.googletagmanager.com https://donorbox.org https://cdn.jsdelivr.net 'sha256-vXxJ/DW4etgZHSYsNp/BmwXIO8AO8yhWB8ieBZCMPsQ=' 'sha256-3ZBDQIAgG25UdkLdDAGtN0Gq2MqBIbfHfUG4PlVN8HM=' {{INLINE_SCRIPT_HASHES}}; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com https://donorbox.org; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://donorbox.org; frame-src https://donorbox.org; form-action 'self' https://formspree.io; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# Standalone chart and network exports (Plotly, vis.js) carry large inline scripts and load from
# cdnjs/jsdelivr; they get a looser policy so they keep rendering. They are isolated pages.
/graphics/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self' https: data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: blob: https:; connect-src 'self' https:; font-src 'self' data: https:; base-uri 'self'; object-src 'none'; frame-ancestors 'none'
